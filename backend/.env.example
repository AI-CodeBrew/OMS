# Django
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Database - must be Supabase's *pooler* connection string (Session pooler,
# port 5432, or Transaction pooler, port 6543). The direct connection host
# (db.<ref>.supabase.co) is IPv6-only and will fail to connect on networks
# without IPv6 egress.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# CORS
CORS_ORIGINS=http://localhost:3000

# Integrations
SHOPIFY_API_VERSION=2024-10
# Must be publicly reachable for Shopify webhook delivery to actually work -
# localhost only lets you register the webhook, not receive it. Point this
# at your ngrok/tunnel URL (or deployed domain) when testing real delivery.
PUBLIC_BACKEND_URL=http://localhost:8000

# Redis / Celery / WhatsApp / Robocall intentionally omitted - not used yet
# (synchronous only for now; see core/events.py). Reintroduce when
# background tasks land.

# Super admin bootstrap (fill these, then: python manage.py bootstrap_super_admin)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Super-admin API IP allowlist (comma-separated public/VPN IPs + localhost)
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
