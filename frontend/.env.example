# Required - Django API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required - Supabase Auth (anon key is safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flags (comma-separated enabled features)
NEXT_PUBLIC_FEATURE_FLAGS=ORDERS,OPS,WMS,RETURNS,FINANCE

# Super-admin UI routes (/superadmin, /admin, …) — server-only, not NEXT_PUBLIC.
# Must match backend ADMIN_IP_ALLOWLIST. Set on Vercel for production.
ADMIN_IP_ALLOWLIST=127.0.0.1,::1
