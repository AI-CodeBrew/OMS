# Required - Django API base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Required - Supabase Auth (anon key is safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Feature flags (comma-separated enabled features)
NEXT_PUBLIC_FEATURE_FLAGS=ORDERS,OPS,WMS,RETURNS,FINANCE
